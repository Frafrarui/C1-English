  { "id": 29, "type": "reporting_verbs", "lead_in": "\"Why don't we go to the cinema?\" suggested Peter.", "keyword": "GOING", "prefix": "Peter ", "suffix": " to the cinema.", "answer": "suggested going" },
  { "id": 30, "type": "reporting_verbs", "lead_in": "\"I wish I hadn't spoken to him,\" she said.", "keyword": "REGRETTED", "prefix": "She ", "suffix": " to him.", "answer": "regretted speaking" },
