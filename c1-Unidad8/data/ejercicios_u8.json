  { "id": 3, "type": "mixed", "lead_in": "\"I have been working here for ten years,\" John told me.", "keyword": "HAD", "prefix": "John told me that ", "suffix": " there for ten years.", "answer": "he had been working" },
  { "id": 4, "type": "mixed", "lead_in": "\"Where did you put the keys?\" my mother asked.", "keyword": "WHERE", "prefix": "My mother asked me ", "suffix": " the keys.", "answer": "where I had put" },
