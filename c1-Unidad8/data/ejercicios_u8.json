  { "id": 10, "type": "mixed", "lead_in": "\"Don't touch that wire!\" the electrician told me.", "keyword": "NOT", "prefix": "The electrician warned ", "suffix": " that wire.", "answer": "me not to touch" },
  { "id": 11, "type": "mixed", "lead_in": "\"I was watching TV when the phone rang,\" he said.", "keyword": "BEEN", "prefix": "He said that ", "suffix": " TV when the phone had rung.", "answer": "he had been watching" },
  { "id": 12, "type": "mixed", "lead_in": "\"Will you help me with this box?\" she asked him.", "keyword": "WHETHER", "prefix": "She asked him ", "suffix": " help her with that box.", "answer": "whether he would" },
