  { "id": 6, "type": "mixed", "lead_in": "\"You must leave immediately!\" the officer said to us.", "keyword": "HAD", "prefix": "The officer told us that ", "suffix": " immediately.", "answer": "we had to leave" },
  { "id": 7, "type": "mixed", "lead_in": "\"I bought this car yesterday,\" she said.", "keyword": "PREVIOUS", "prefix": "She said she had bought that car ", "suffix": ".", "answer": "the previous day" },
