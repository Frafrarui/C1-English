  { "id": 15, "type": "mixed", "lead_in": "\"I will have finished by Friday,\" he promised.", "keyword": "WOULD", "prefix": "He promised that ", "suffix": " finished by Friday.", "answer": "he would have" },
  { "id": 16, "type": "mixed", "lead_in": "\"We are leaving now,\" they announced.", "keyword": "THEN", "prefix": "They announced that ", "suffix": ".", "answer": "they were leaving then" },
  { "id": 17, "type": "mixed", "lead_in": "\"How long have you lived here?\" he asked me.", "keyword": "HAD", "prefix": "He asked me how long ", "suffix": " there.", "answer": "I had lived" },
