  { "id": 21, "type": "reporting_verbs", "lead_in": "\"I'm sorry I broke the vase,\" he said.", "keyword": "APOLOGIZED", "prefix": "He ", "suffix": " the vase.", "answer": "apologized for breaking" },
  { "id": 22, "type": "reporting_verbs", "lead_in": "\"Yes, I stole the money,\" the thief said.", "keyword": "ADMITTED", "prefix": "The thief ", "suffix": " the money.", "answer": "admitted to stealing" },
